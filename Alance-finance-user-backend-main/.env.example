# Copy to .env and fill in. .env is gitignored and must never be committed.
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/acf_user_dev

# Must be a long random value. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-48-random-bytes
JWT_EXPIRES_IN_SECONDS=86400

# Polygon Amoy. Included in the signed message so a signature cannot be replayed on another chain.
CHAIN_ID=80002

CHALLENGE_TTL_SECONDS=300
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Integration tests connect ONLY to this, never to MONGODB_URI, because they delete every
# document between cases. Leave unset to skip them. The database name must contain "test".
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/acf_user_test

# ── Chain access (read-only) ─────────────────────────────────────────────────
# The backend never signs: it only reads walletOf() and owner().
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/<key>
# Must match CHAIN_ID above. Superseded factory deployments exist on Amoy — use the
# address from deployments/<chainId>/, never a hardcoded or older one.
USER_WALLET_FACTORY_ADDRESS=0xC7ea9304a56833f0FBAa98bf8Cc78B0ccb7D6Be8

# debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Swap contract for CHAIN_ID above; swap records are verified against logs from this address.
ACF_SWAP_ADDRESS=0x16F2d748A5a4359d1948F261662dD9f0d5fEadDD
# Confirmations before a swap is recorded; a mined tx counts as 1.
# Optional, defaults to 1. Raising it makes the client retry while it waits.
SWAP_CONFIRMATIONS=1

# Canonical staking proxy. A STALE proxy exists on Amoy with identical-looking state but a
# dead ACF token; startup verifies ACFStaking.acf() == ACF_TOKEN_ADDRESS and refuses to run
# if they disagree.
ACF_STAKING_ADDRESS=0x9eDbbf53f784450CC8Fd50730984Cb7D8DDF743d
ACF_TOKEN_ADDRESS=0x7AEB95CaE1e5442Fe1170555ae81280B763D3BF1

# Bond. Startup verifies ACFBond.acf()/usdt()/staking()/swap() all match the canonical
# addresses configured above, and refuses to run on any mismatch.
ACF_BOND_ADDRESS=0x3a97D05a088aDBB79936914F245c2E0bf7F511f2
MOCK_USDT_ADDRESS=0x21ff9e803fc496e4db1c1a6c354690636b9fc330

# ── Referral root ────────────────────────────────────────────────────────────
# The admin wallet that owns the top of the referral tree. ONE value, correct from the very
# first start, and it never changes.
#
# Identified by wallet rather than by User.userId because the wallet is known before any
# database exists. Until this wallet signs in there is no root, so other registrations are
# refused rather than given a null parent. The moment it signs in, registration opens — no
# restart and no second variable.
ROOT_ADMIN_EOA=0xYourAdminExternalEOA

# ── Reward engine ────────────────────────────────────────────────────────────
# The first twelve-hour epoch the engine may settle, as epochId = snapshotAt / 43200.
# epochId * 43200 is always a 00:00 or 12:00 UTC boundary, and an epoch settles the window
# that JUST COMPLETED: epoch N covers [N*43200 - 43200, N*43200).
#
# Required and deliberately explicit. Without it a first run would backfill every window since
# the contracts were deployed, inventing months of liability nobody agreed to.
#
#   today's:  node -e "console.log(Math.floor(Date.now()/1000/43200))"
REWARD_ENGINE_ACTIVATION_EPOCH=
REWARD_STAKE_PAGE_SIZE=200
REWARD_MULTICALL_BATCH=100

# ── Team Reward (Phase 2: Level / Rank / Global) ─────────────────────────────
# Ceiling on the as-of referral graph a Team Reward epoch will load. Exceeding it FAILS the
# epoch; it never truncates, because Rank is computed from the entire downline and a partial
# graph would silently understate someone's team.
REWARD_PHASE2_MAX_GRAPH_NODES=100000
# How long a worker may own a PROCESSING Team Reward epoch before another may reclaim it.
REWARD_PHASE2_LEASE_MS=1800000

# ---------------------------------------------------------------------------
# Executor signing key — THE ONLY KEY THIS SERVICE EVER HOLDS
#
# Set this ONLY in the environment of the executor processes:
#   npm run settlement:execute      Treasury.fundRewardEpoch, Withdrawal.finalizeEpoch
#   npm run dao-revenue:execute     Treasury.fundDAORevenueEpoch, Distributor.distributeBatch
#
# Leave it unset for the API and the reward worker: neither can reach the signer module, and
# both run perfectly without it. The account needs EPOCH_EXECUTOR_ROLE on Treasury, Withdrawal
# and the DAO revenue distributor, plus native POL for gas — never ACF.
#
# NEVER the admin/deployer key: that one also carries DEFAULT_ADMIN and UPGRADER over the whole
# protocol, so a compromise of this host would become full control of the Treasury.
#
# Left deliberately empty here. In production inject it from a secret manager at boot rather
# than writing it to disk.
# ---------------------------------------------------------------------------
EPOCH_EXECUTOR_PRIVATE_KEY=
